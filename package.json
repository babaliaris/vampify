{
  "name": "vampify",
  "version": "1.0.0",
  "description": "A customized Fastify backend framework",
  "license": "ISC",
  "author": "babaliaris",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "build": "rimraf dist && tsc && tsc-alias",
    "start": "npm run build && cross-env NODE_ENV=production node dist/server.js",
    "test": "cross-env NODE_ENV=test node --test --import tsx \"src/**/*.{test,spec}.ts\"",
    "db:push": "cross-env NODE_ENV=development drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "cross-env NODE_ENV=development tsx src/db/migrate.ts",
    "db:migrate:prod": "cross-env NODE_ENV=production node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/env": "^5.0.3",
    "@fastify/sensible": "^6.0.4",
    "@sinclair/typebox": "^0.34.48",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "mysql2": "^3.16.3",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "drizzle-kit": "^0.31.8",
    "rimraf": "^6.1.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
