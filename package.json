{
  "name": "@vampify/core",
  "version": "1.0.0",
  "description": "A customized Fastify backend framework",
  "license": "ISC",
  "author": "babaliaris",
  "type": "module",
  "main": "dist/core/vampify.js",
  "types": "./dist/core/vampify.d.ts",
  "files": [
    "dist/core",
    "README.md"
  ],
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/sandbox/server.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "cross-env NODE_ENV=test node --test --import tsx \"src/**/*.{test,spec}.ts\"",
    "db:push": "cross-env NODE_ENV=development drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "cross-env NODE_ENV=development tsx src/sandbox/db/migrate.ts"
  },
  "peerDependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/env": "^5.0.3",
    "@fastify/sensible": "^6.0.4",
    "@sinclair/typebox": "^0.34.48",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "mysql2": "^3.16.3"
  },
  "devDependencies": {
    "@fastify/autoload": "^6.3.1",
    "@fastify/env": "^5.0.3",
    "@fastify/sensible": "^6.0.4",
    "@sinclair/typebox": "^0.34.48",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "mysql2": "^3.16.3",
    "@types/node": "^25.2.1",
    "drizzle-kit": "^0.31.8",
    "rimraf": "^6.1.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "pino-pretty": "^13.1.3"
  }
}
