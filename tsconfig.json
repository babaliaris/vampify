{
  "compilerOptions": {
    /* Basic Options */
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
  
    /* Strictness */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    
    /* Module Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@vampify/core": ["./src/core/vampify.ts"],
      "@vampify/env": ["./src/core/plugins/environment.ts"],
      "@vampify/auth": ["./src/core/plugins/auth.ts"],
      "@vampify/literals": ["./src/core/vampify-literals.ts"],
      "@vampify/test": ["./src/core/vampify-test.ts"],
      "@vampify/utils": ["./src/core/utilities/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules", "dist"
  ]
}